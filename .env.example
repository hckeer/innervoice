# ============================================================================
# RAG ASSISTANT - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and adjust values for your deployment

# ── Groq API (Required for LLM) ──────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Vector Store Configuration ───────────────────────────────────────────
# Choose between local FAISS (USE_QDRANT=false) or Qdrant Cloud (USE_QDRANT=true)
USE_QDRANT=false

# Qdrant Cloud Configuration (if USE_QDRANT=true)
QDRANT_URL=https://your-cluster.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=conversations
QDRANT_TIMEOUT_SECONDS=20

# Local FAISS Paths (if USE_QDRANT=false)
FAISS_INDEX_PATH=data/index.faiss
METADATA_PATH=data/metadata.pkl
CONVERSATIONS_PATH=data/conversations.jsonl

# ── Embedding Model ──────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ── Retrieval Settings ───────────────────────────────────────────────────
TOP_K=5
ENABLE_RERANKING=false
PIPELINE_QUERY_TIMEOUT_SECONDS=90

# ── LLM Settings ─────────────────────────────────────────────────────────
GROQ_MODEL=openai/gpt-oss-120b
MAX_TOKENS=512
TEMPERATURE=0.7
